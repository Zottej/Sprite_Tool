{
  "name": "sprite_padder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -b && vite build && node scripts/deploy-joa.mjs",
    "build": "npm run build:web && electron-builder --win portable && node scripts/deploy-desktop.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "npm run build:web && electron .",
    "desktop:run": "electron .",
    "desktop:pack": "npm run build"
  },
  "dependencies": {
    "gputex": "^0.6.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-singlefile": "^2.3.2"
  },
  "build": {
    "appId": "com.joa.spritepadder",
    "productName": "JOA Sprite Padder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "JOA_Sprite_Padder_Desktop.${ext}"
    }
  }
}
